# Private server-side PostgreSQL connection string. Do not expose this to Next.js.
DATABASE_URL=

# Optional app settings.
APP_NAME=Parcha Judgment Search API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
QUERY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Cloudflare control-plane credentials. Create a scoped custom API token;
# never use or store the Global API Key here.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=de7ed05f-e25c-467a-9f80-106d0e0e5acf
CLOUDFLARE_D1_DATABASE_NAME=parcha-judgments
CLOUDFLARE_VECTORIZE_INDEX=parcha-judgment-chunks
CLOUDFLARE_WORKER_NAME=parcha-search-api
CLOUDFLARE_WORKER_URL=https://parcha-search-api.politestranger18.workers.dev

# Canonical pilot data paths. Override if the data-prep repository moves.
PILOT_MANIFEST_PATH=/home/shauray/Downloads/unemployment/indian-supreme-court-judgments/pilot/manifest.jsonl
PILOT_DOCUMENTS_DIR=/home/shauray/Downloads/unemployment/indian-supreme-court-judgments/judgment-search-pilot/work/final/documents
PILOT_CHUNKS_PATH=/home/shauray/Downloads/unemployment/indian-supreme-court-judgments/judgment-search-pilot/work/final/chunks.jsonl.gz
PILOT_EMBEDDINGS_DIR=/home/shauray/Downloads/unemployment/indian-supreme-court-judgments/judgment-search-pilot/work/embeddings-gpu/shards
SCHEMA_SQL_PATH=/home/shauray/Downloads/unemployment/indian-supreme-court-judgments/judgment-search-pilot/sql/001_schema.sql
GEMINI_API_KEY=
