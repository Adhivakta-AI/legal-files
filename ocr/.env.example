# Absolute host path containing manifest.jsonl for the active batch.
BATCH_DIR=/home/your-user/judgment-ocr-data/batch-01

# Use at most physical CPU cores minus one. The Ryzen 5 5600H can use 5.
WORKERS=5
EXTRACT_WORKERS=2
DOWNLOAD_WORKERS=8
OCR_DPI=300

# Persistent Paddle model cache. Relative paths resolve from this ocr directory.
MODEL_CACHE_DIR=./model-cache
OCR_IMAGE=judgment-ocr:local

# Cloudflare R2 archive for finished batches (used by upload-batch-to-r2.sh and
# download-batch-from-r2.sh). Create the bucket and a scoped API token first, see
# README.md "Archive finished batches to R2". The AWS CLI reads the access key
# ID/secret from an `aws configure --profile r2` profile, not from this file.
R2_ACCOUNT_ID=
R2_BUCKET=judgment-ocr-corpus
R2_ENDPOINT_URL=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
AWS_PROFILE=r2

# Where download-batch-from-r2.sh writes batches pulled down for local embedding.
R2_DOWNLOAD_ROOT=/home/your-user/judgment-ocr-data/r2-batches
