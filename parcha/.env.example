# Server-only. Never prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional; this production endpoint is also the server-side default.
SEARCH_API_URL=https://parcha-search-api.politestranger18.workers.dev/api/search
SEARCH_SERVICE_TOKEN=

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional authentication email.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Lex Archives <auth@example.com>

# Public canonical application URL (not a secret).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
