{
  "name": "parcha",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node --env-file=../backend/.env node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "node --env-file=../backend/.env node_modules/next/dist/bin/next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:migrate": "wrangler d1 migrations apply parcha-app --remote",
    "d1:migrate:local": "wrangler d1 migrations apply parcha-app --local",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "eval:score": "node evaluation/score.mjs",
    "eval:test": "node --test evaluation/metrics.test.mjs",
    "reading-copy:build": "node scripts/build-reading-copy.mjs",
    "reading-copy:enrich": "node scripts/enrich-reading-copy-layout.mjs",
    "reading-copy:pdf": "node scripts/generate-reading-copy-pdf.mjs",
    "reading-copy:test": "node --test scripts/lib/poppler-layout.test.mjs scripts/lib/case-law-reference.test.mjs scripts/lib/reading-copy-validation.test.mjs",
    "test:grounding": "node --test lib/research/grounding-validation.test.mjs lib/research/query-validation.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@gsap/react": "^2.1.2",
    "@opennextjs/cloudflare": "^1.20.4",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.25.0",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
