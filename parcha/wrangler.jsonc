{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lex-archives-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "parcha-app",
      "database_id": "b1083802-55e4-450a-861f-4641868fa8bf",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://lex-archives-app.politestranger18.workers.dev",
    "NEXT_PUBLIC_SITE_URL": "https://lex-archives-app.politestranger18.workers.dev"
  }
}
